<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
    maxHeight="-Infinity" maxWidth="-Infinity"
    minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="640.0" prefWidth="390.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="proyecto.intermodular.app.controllers.CrearUsuarioController">
    <children>
        <AnchorPane prefHeight="97.0" prefWidth="390.0"
                    style="-fx-background-color: #1a3a5c;">
            <children>
                <Label layoutX="21.0" layoutY="35.0"
                       text="Crear usuario" textFill="WHITE">
                    <font><Font name="System Bold" size="28.0"/></font>
                </Label>
            </children>
        </AnchorPane>
        <ScrollPane layoutX="0.0" layoutY="97.0"
                    prefHeight="453.0" prefWidth="390.0"
                    fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox prefWidth="342.0" spacing="12.0"
                      style="-fx-padding: 20 24 20 24;">
                    <Label text="Nombre *" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <TextField fx:id="TNombre"
                               prefHeight="36.0" promptText="Nombre completo">
                        <font><Font size="14.0"/></font>
                    </TextField>
                    <Label text="DNI *" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <TextField fx:id="TDNI"
                               prefHeight="36.0" promptText="12345678A">
                        <font><Font size="14.0"/></font>
                    </TextField>
                    <Label text="Email *" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <TextField fx:id="TEmail"
                               prefHeight="36.0" promptText="correo@ejemplo.com">
                        <font><Font size="14.0"/></font>
                    </TextField>
                    <Label text="Teléfono" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <TextField fx:id="TTelefono"
                               prefHeight="36.0" promptText="600000000 (opcional)">
                        <font><Font size="14.0"/></font>
                    </TextField>
                    <Label text="Tipo de usuario *" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <ComboBox fx:id="CTipoUsuario"
                              prefHeight="36.0" prefWidth="342.0"
                              promptText="Selecciona un tipo"/>
                    <Label text="Contraseña *" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <PasswordField fx:id="TPassword"
                                   prefHeight="36.0" promptText="Mínimo 6 caracteres">
                        <font><Font size="14.0"/></font>
                    </PasswordField>
                    <Label text="Confirmar contraseña *" style="-fx-text-fill: #6c757d;">
                        <font><Font size="12.0"/></font>
                    </Label>
                    <PasswordField fx:id="TPasswordConfirm"
                                   prefHeight="36.0" promptText="Repite la contraseña">
                        <font><Font size="14.0"/></font>
                    </PasswordField>
                </VBox>
            </content>
        </ScrollPane>
        <Button fx:id="BCrear"
                layoutX="24.0" layoutY="562.0"
                prefHeight="36.0" prefWidth="165.0"
                text="✔ Crear usuario"
                onAction="#handleCrear"
                style="-fx-background-color: #1a3a5c; -fx-text-fill: white; -fx-background-radius: 6;">
            <font><Font name="System Bold" size="14.0"/></font>
        </Button>
        <Button fx:id="BVolver"
                layoutX="201.0" layoutY="562.0"
                prefHeight="36.0" prefWidth="165.0"
                text="← Volver"
                onAction="#handleVolver"
                style="-fx-background-color: #e2e3e5; -fx-text-fill: #41464b; -fx-background-radius: 6;">
            <font><Font size="14.0"/></font>
        </Button>
    </children>
</AnchorPane>
