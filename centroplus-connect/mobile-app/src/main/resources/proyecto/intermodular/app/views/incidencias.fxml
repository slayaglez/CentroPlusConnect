<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
    maxHeight="-Infinity" maxWidth="-Infinity"
    minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="640.0" prefWidth="390.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="proyecto.intermodular.app.controllers.IncidenciaController">
    <children>
        <AnchorPane prefHeight="97.0" prefWidth="390.0"
                    style="-fx-background-color: #1a3a5c;">
            <children>
                <Label layoutX="21.0" layoutY="35.0"
                       text="Incidencias" textFill="WHITE">
                    <font><Font name="System Bold" size="32.0"/></font>
                </Label>
            </children>
        </AnchorPane>
        <HBox layoutX="16.0" layoutY="110.0"
              prefWidth="358.0" spacing="8.0" alignment="CENTER_LEFT">
            <TextField fx:id="TBuscarIncidencia"
                       prefHeight="32.0" prefWidth="200.0"
                       promptText="Buscar por asunto o usuario..."
                       onKeyReleased="#handleBuscar">
                <font><Font size="13.0"/></font>
            </TextField>
            <ComboBox fx:id="CIncidencias"
                      prefHeight="32.0" prefWidth="150.0"
                      onAction="#handleFiltro"/>
        </HBox>
        <HBox layoutX="16.0" layoutY="152.0"
              prefWidth="358.0" spacing="8.0">
            <Button fx:id="BCrear"
                    prefHeight="32.0" prefWidth="110.0"
                    text="+ Crear"
                    onAction="#handleCrear"
                    style="-fx-background-color: #d8f0a3; -fx-text-fill: #4a6e2a; -fx-background-radius: 6;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="BEditar"
                    prefHeight="32.0" prefWidth="110.0"
                    text="✎ Editar"
                    onAction="#handleEditar"
                    style="-fx-background-color: #fff3cd; -fx-text-fill: #856404; -fx-background-radius: 6;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="BEliminar"
                    prefHeight="32.0" prefWidth="110.0"
                    text="✕ Eliminar"
                    onAction="#handleEliminar"
                    style="-fx-background-color: #f8d7da; -fx-text-fill: #842029; -fx-background-radius: 6;">
                <font><Font size="13.0"/></font>
            </Button>
        </HBox>
        <AnchorPane layoutX="16.0" layoutY="200.0"
                    prefHeight="340.0" prefWidth="358.0"
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-border-width: 1;">
            <children>
                <Label fx:id="LEstado"
                       layoutX="228.0" layoutY="16.0"
                       prefWidth="114.0" prefHeight="24.0"
                       alignment="CENTER"
                       style="-fx-background-color: #cfe2ff; -fx-text-fill: #084298; -fx-background-radius: 12; -fx-font-size: 12;">
                    <font><Font size="12.0"/></font>
                </Label>
                <Label text="Asunto" layoutX="16.0" layoutY="16.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LAsunto" layoutX="16.0" layoutY="32.0"
                       prefWidth="205.0"
                       style="-fx-text-fill: #212529;">
                    <font><Font name="System Bold" size="17.0"/></font>
                </Label>
                <Separator layoutX="16.0" layoutY="70.0" prefWidth="326.0"/>
                <Label text="ID usuario" layoutX="16.0" layoutY="82.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LIdUsuario" layoutX="16.0" layoutY="98.0"
                       prefWidth="150.0">
                    <font><Font size="14.0"/></font>
                </Label>
                <Label text="Fecha" layoutX="190.0" layoutY="82.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LFecha" layoutX="190.0" layoutY="98.0"
                       prefWidth="152.0">
                    <font><Font size="14.0"/></font>
                </Label>
                <Separator layoutX="16.0" layoutY="126.0" prefWidth="326.0"/>
                <Label text="Descripción" layoutX="16.0" layoutY="138.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LDescripcion" layoutX="16.0" layoutY="154.0"
                       prefWidth="326.0" wrapText="true">
                    <font><Font size="13.0"/></font>
                </Label>
                <Separator layoutX="16.0" layoutY="230.0" prefWidth="326.0"/>
                <Button fx:id="BCambiarEstado"
                        layoutX="16.0" layoutY="246.0"
                        prefHeight="28.0" prefWidth="140.0"
                        text="Cambiar estado"
                        onAction="#handleCambiarEstado"
                        style="-fx-background-color: #e2e3e5; -fx-text-fill: #41464b; -fx-background-radius: 6;">
                    <font><Font size="12.0"/></font>
                </Button>
                <Label text="◀" layoutX="16.0" layoutY="298.0"
                       onMouseClicked="#handleAnterior"
                       style="-fx-cursor: hand; -fx-text-fill: #1a3a5c;">
                    <font><Font size="22.0"/></font>
                </Label>
                <Label fx:id="LContador" layoutX="145.0" layoutY="302.0"
                       prefWidth="68.0" alignment="CENTER"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="13.0"/></font>
                </Label>
                <Label text="▶" layoutX="316.0" layoutY="298.0"
                       onMouseClicked="#handleSiguiente"
                       style="-fx-cursor: hand; -fx-text-fill: #1a3a5c;">
                    <font><Font size="22.0"/></font>
                </Label>
            </children>
        </AnchorPane>
        <AnchorPane layoutY="566.0" prefHeight="74.0" prefWidth="390.0"
                    style="-fx-background-color: #e6dcdc;">
            <children>
                <Label fx:id="LNavInicio"      layoutX="14.0"  layoutY="27.0" onMouseClicked="#handleNavInicio"      text="Inicio"      style="-fx-cursor: hand;"><font><Font size="14.0"/></font></Label>
                <Label fx:id="LNavUsuarios"    layoutX="68.0"  layoutY="27.0" onMouseClicked="#handleNavUsuarios"    text="Usuarios"    style="-fx-cursor: hand;"><font><Font size="14.0"/></font></Label>
                <Label fx:id="LNavActividades" layoutX="137.0" layoutY="27.0" onMouseClicked="#handleNavActividades" text="Actividades" style="-fx-cursor: hand;"><font><Font size="14.0"/></font></Label>
                <Label fx:id="LNavReservas"    layoutX="228.0" layoutY="27.0" onMouseClicked="#handleNavReservas"    text="Reservas"    style="-fx-cursor: hand;"><font><Font size="14.0"/></font></Label>
                <Label fx:id="LNavIncidencias" layoutX="300.0" layoutY="27.0" onMouseClicked="#handleNavIncidencias" text="Incidencias" style="-fx-cursor: hand; -fx-font-weight: bold;"><font><Font size="14.0"/></font></Label>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
