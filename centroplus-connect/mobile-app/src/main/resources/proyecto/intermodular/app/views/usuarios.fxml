<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane
    maxHeight="-Infinity" maxWidth="-Infinity"
    minHeight="-Infinity" minWidth="-Infinity"
    prefHeight="640.0" prefWidth="390.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="proyecto.intermodular.app.controllers.UsuarioController">

    <children>
        <AnchorPane prefHeight="97.0" prefWidth="390.0"
                    style="-fx-background-color: #1a3a5c;">
            <children>
                <Label layoutX="21.0" layoutY="35.0"
                       text="Usuarios" textFill="WHITE">
                    <font><Font name="System Bold" size="32.0"/></font>
                </Label>
            </children>
        </AnchorPane>
        <HBox layoutX="16.0" layoutY="110.0"
              prefWidth="358.0" spacing="8.0" alignment="CENTER_LEFT">
            <TextField fx:id="TBuscarUsuario"
                       prefHeight="32.0" prefWidth="200.0"
                       promptText="Buscar por nombre, DNI o email..."
                       onKeyReleased="#handleBuscar">
                <font><Font size="13.0"/></font>
            </TextField>
            <ComboBox fx:id="CUsuarios"
                      prefHeight="32.0" prefWidth="150.0"
                      onAction="#handleFiltro"/>
        </HBox>
        <HBox layoutX="16.0" layoutY="152.0"
              prefWidth="358.0" spacing="8.0">
            <Button fx:id="BCrear"
                    prefHeight="32.0" prefWidth="110.0"
                    text="+ Crear"
                    onAction="#handleCrear"
                    style="-fx-background-color: #d8f0a3; -fx-text-fill: #4a6e2a; -fx-background-radius: 6;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="BEditar"
                    prefHeight="32.0" prefWidth="110.0"
                    text="✎ Editar"
                    onAction="#handleEditar"
                    style="-fx-background-color: #fff3cd; -fx-text-fill: #856404; -fx-background-radius: 6;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="BEliminar"
                    prefHeight="32.0" prefWidth="110.0"
                    text="✕ Eliminar"
                    onAction="#handleEliminar"
                    style="-fx-background-color: #f8d7da; -fx-text-fill: #842029; -fx-background-radius: 6;">
                <font><Font size="13.0"/></font>
            </Button>
        </HBox>
        <AnchorPane layoutX="16.0" layoutY="200.0"
                    prefHeight="290.0" prefWidth="358.0"
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-border-width: 1;">
            <children>
                <Label fx:id="LTipoUsuario"
                       layoutX="248.0" layoutY="16.0"
                       prefWidth="94.0" prefHeight="24.0"
                       alignment="CENTER"
                       style="-fx-background-color: #cfe2ff; -fx-text-fill: #084298; -fx-background-radius: 12; -fx-font-size: 12;">
                    <font><Font size="12.0"/></font>
                </Label>
                <Label text="Nombre" layoutX="16.0" layoutY="16.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LNombre" layoutX="16.0" layoutY="32.0"
                       prefWidth="220.0"
                       style="-fx-text-fill: #212529; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="18.0"/></font>
                </Label>
                <Separator layoutX="16.0" layoutY="72.0" prefWidth="326.0"/>
                <Label text="DNI" layoutX="16.0" layoutY="84.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LDNI" layoutX="16.0" layoutY="100.0"
                       prefWidth="150.0">
                    <font><Font size="14.0"/></font>
                </Label>
                <Label text="Teléfono" layoutX="180.0" layoutY="84.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LTelefono" layoutX="180.0" layoutY="100.0"
                       prefWidth="162.0">
                    <font><Font size="14.0"/></font>
                </Label>
                <Separator layoutX="16.0" layoutY="128.0" prefWidth="326.0"/>
                <Label text="Email" layoutX="16.0" layoutY="140.0"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="11.0"/></font>
                </Label>
                <Label fx:id="LEmail" layoutX="16.0" layoutY="156.0"
                       prefWidth="326.0">
                    <font><Font size="14.0"/></font>
                </Label>
                <Separator layoutX="16.0" layoutY="184.0" prefWidth="326.0"/>
                <Label text="◀" layoutX="16.0" layoutY="224.0"
                       onMouseClicked="#handleAnterior"
                       style="-fx-cursor: hand; -fx-text-fill: #1a3a5c;">
                    <font><Font size="22.0"/></font>
                </Label>
                <Label fx:id="LContador" layoutX="145.0" layoutY="228.0"
                       prefWidth="68.0" alignment="CENTER"
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="13.0"/></font>
                </Label>
                <Label text="▶" layoutX="316.0" layoutY="224.0"
                       onMouseClicked="#handleSiguiente"
                       style="-fx-cursor: hand; -fx-text-fill: #1a3a5c;">
                    <font><Font size="22.0"/></font>
                </Label>
            </children>
        </AnchorPane>
        <AnchorPane
            layoutY="566.0"
            prefHeight="74.0" prefWidth="390.0"
            style="
                -fx-background-color: white;
                -fx-effect: dropshadow(gaussian, rgba(26,58,92,0.12), 10, 0, 0, -3);
            ">
            <children>
                <HBox
                    layoutX="0" layoutY="0"
                    prefWidth="390.0" prefHeight="74.0"
                    alignment="CENTER"
                    spacing="0">
                    <children>
                        <VBox
                            prefWidth="78.0" prefHeight="74.0"
                            alignment="CENTER" spacing="3"
                            onMouseClicked="#handleNavInicio"
                            style="-fx-cursor: hand;">
                            <FontIcon iconLiteral="mdi2h-home" iconSize="20" iconColor="#7a96b0"/>
                            <Label text="Inicio"
                                style="-fx-font-family: 'Carlito'; -fx-font-size: 10px; -fx-text-fill: #7a96b0;"/>
                        </VBox>
                        <VBox
                            prefWidth="78.0" prefHeight="74.0"
                            alignment="CENTER" spacing="3"
                            onMouseClicked="#handleNavUsuarios"
                            style="-fx-cursor: hand; -fx-border-color: transparent transparent #2e6da4 transparent; -fx-border-width: 0 0 3 0;">
                            <FontIcon iconLiteral="mdi2a-account" iconSize="20" iconColor="#2e6da4"/>
                            <Label fx:id="LNavUsuarios" text="Usuarios"
                                style="-fx-font-family: 'Carlito'; -fx-font-size: 10px; -fx-text-fill: #2e6da4;"/>
                        </VBox>
                        <VBox
                            prefWidth="78.0" prefHeight="74.0"
                            alignment="CENTER" spacing="3"
                            onMouseClicked="#handleNavActividades"
                            style="-fx-cursor: hand;">
                            <FontIcon iconLiteral="mdi2r-run" iconSize="20" iconColor="#7a96b0"/>
                            <Label text="Actividades"
                                style="-fx-font-family: 'Carlito'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7a96b0;"/>
                        </VBox>
                        <VBox
                            prefWidth="78.0" prefHeight="74.0"
                            alignment="CENTER" spacing="3"
                            onMouseClicked="#handleNavReservas"
                            style="-fx-cursor: hand;">
                            <FontIcon iconLiteral="mdi2c-calendar" iconSize="20" iconColor="#7a96b0"/>
                            <Label text="Reservas"
                                style="-fx-font-family: 'Carlito'; -fx-font-size: 10px; -fx-text-fill: #7a96b0;"/>
                        </VBox>
                        <VBox
                            prefWidth="78.0" prefHeight="74.0"
                            alignment="CENTER" spacing="3"
                            onMouseClicked="#handleNavIncidencias"
                            style="-fx-cursor: hand;">
                            <FontIcon iconLiteral="mdi2a-alert" iconSize="20" iconColor="#a42e2eff"/>
                            <Label text="Incidencias"
                                style="-fx-font-family: 'Carlito'; -fx-font-size: 10px; -fx-text-fill: #7a96b0;"/>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
